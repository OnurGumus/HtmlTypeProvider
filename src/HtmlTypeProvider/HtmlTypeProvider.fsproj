<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata -->
    <PackageId>HtmlTypeProvider</PackageId>
    <Version>0.9.1</Version>
    <Authors>HtmlTypeProvider Contributors</Authors>
    <Description>An F# type provider that parses HTML templates with ${Hole} syntax and generates strongly-typed builder APIs producing HTML strings.</Description>
    <PackageTags>fsharp;typeprovider;html;template</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NU5100: design-time DLLs intentionally outside lib/ -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NodeTypes.fs" />
    <Compile Include="Attr.fs" />
    <Compile Include="Node.fs" />
    <Compile Include="TemplatingInternals.fs" />
    <Compile Include="TemplateRuntime.fs" />
  </ItemGroup>
  <!-- Ordering, and nothing else. The designer project builds straight into this
       project's obj/$(Configuration)/typeproviders folder through its own OutputPath, so
       there is nothing to copy; what was missing is that building or packing this
       project did not build that one. The staged DLL was therefore whatever the last
       person to build the designer had left there, and a pack could ship a designer
       months older than the source beside it, silently. That is how a fix to the
       designer went out with no effect at all.

       ReferenceOutputAssembly is false because the runtime assembly must not reference
       the designer, and PrivateAssets keeps it out of the package's dependencies. -->
  <ItemGroup>
    <ProjectReference Include="..\HtmlTypeProvider.Provider\HtmlTypeProvider.Provider.fsproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack the design-time provider assembly and its dependencies into the nupkg.
       Only include the provider DLL and HtmlAgilityPack; FSharp.Core is already
       available to the compiler host so we exclude it and its satellite assemblies. -->
  <ItemGroup>
    <None Include="obj\$(Configuration)\typeproviders\fsharp41\netstandard2.0\HtmlTypeProvider.Provider.dll"
          Pack="true"
          PackagePath="typeproviders\fsharp41\netstandard2.0\" />
    <None Include="obj\$(Configuration)\typeproviders\fsharp41\netstandard2.0\HtmlAgilityPack.dll"
          Pack="true"
          PackagePath="typeproviders\fsharp41\netstandard2.0\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
