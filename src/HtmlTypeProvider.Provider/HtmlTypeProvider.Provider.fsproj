<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <OutputType>Library</OutputType>
    <OutputPath>..\HtmlTypeProvider\obj\$(Configuration)\typeproviders\fsharp41\netstandard2.0</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefineConstants>IS_DESIGNTIME</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ProvidedTypes.fsi" />
    <Compile Include="ProvidedTypes.fs" />
    <Compile Include="..\HtmlTypeProvider\NodeTypes.fs" Link="NodeTypes.fs" />
    <Compile Include="..\HtmlTypeProvider\Attr.fs" Link="Attr.fs" />
    <Compile Include="..\HtmlTypeProvider\Node.fs" Link="Node.fs" />
    <Compile Include="..\HtmlTypeProvider\TemplatingInternals.fs" Link="TemplatingInternals.fs" />
    <Compile Include="..\HtmlTypeProvider\TemplateRuntime.fs" Link="TemplateRuntime.fs" />
    <Compile Include="Utilities.fs" />
    <Compile Include="Path.fs" />
    <Compile Include="Parsing.fs" />
    <Compile Include="ConvertExpr.fs" />
    <Compile Include="CodeGen.fs" />
    <Compile Include="Provider.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.*" />
    <!-- Pinned low, and deliberately. A designer assembly is loaded into whatever host
         is type checking: the compiler, but also an IDE's language service, which ships
         its own FSharp.Core and is usually behind. Built against the SDK's implicit
         FSharp.Core (10.1.0.0 on a .NET 11 preview) it loads in the compiler and fails
         everywhere else with FileNotFoundException, so the provided types simply vanish
         in the editor while the build stays green. The loader resolves a lower version
         to the host's, so this works in both. -->
    <PackageReference Include="FSharp.Core" Version="8.0.400" />
  </ItemGroup>
</Project>
